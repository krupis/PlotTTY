/* PlotTTY dark application stylesheet */

* {
    color: #dce3ea;
    font-family: "Inter", "Segoe UI", "Arial", sans-serif;
    font-size: 10pt;
    selection-background-color: #2e8b57;
    selection-color: #ffffff;
}

QMainWindow,
QDialog,
#centralwidget {
    background-color: #252b32;
}

#centralwidget {
    border: none;
}

QMenuBar {
    background-color: #20262d;
    border-bottom: 1px solid #3b444e;
    padding: 2px 6px;
}

QMenuBar::item {
    background-color: transparent;
    border-radius: 4px;
    padding: 5px 10px;
}

QMenuBar::item:selected {
    background-color: #333b45;
    color: #ffffff;
}

QMenu {
    background-color: #252b32;
    border: 1px solid #4a5561;
    border-radius: 6px;
    padding: 6px;
}

QMenu::item {
    border-radius: 4px;
    padding: 6px 28px 6px 10px;
}

QMenu::item:selected {
    background-color: #3cb371;
    color: #101418;
}

QFrame#RightFrame {
    background-color: #303841;
    border: 1px solid #4b5561;
    border-radius: 8px;
}

QLabel {
    color: #dce3ea;
    background-color: transparent;
}

QLabel#AutomaticLabel,
QLabel#ManualLabel {
    color: #9ece9a;
    font-size: 10.5pt;
    font-weight: 700;
    margin-top: 4px;
}

QLabel#DataReceivedLabel {
    color: #a6accd;
    font-weight: 600;
    padding: 0 8px;
}

QPushButton {
    background-color: #3a3f4b;
    border: 1px solid #5c6370;
    border-radius: 4px;
    color: #e0e0e0;
    font-size: 9pt;
    font-weight: 700;
    min-height: 24px;
    padding: 3px 10px;
}

QPushButton:hover {
    background-color: #4b5263;
    border-color: #89b4fa;
}

QPushButton:pressed {
    background-color: #2c313c;
    border-color: #89b4fa;
}

QPushButton:disabled {
    background-color: #2a2d34;
    border-color: #444a53;
    color: #777f89;
}

QPushButton#RemoveRuleButton {
    color: #f4b3bc;
}

QPushButton#RemoveRuleButton:hover {
    background-color: #4a3038;
    border-color: #f7768e;
}

QPlainTextEdit,
QLineEdit,
QComboBox,
QSpinBox,
QTableWidget {
    background-color: #21272e;
    border: 1px solid #555e68;
    border-radius: 4px;
    color: #f0f4f8;
    font-size: 9pt;
}

QPlainTextEdit {
    padding: 6px;
}

QPlainTextEdit#ConsoleTextEdit {
    background-color: #151a20;
    border-color: #3d4650;
    color: #dce3ea;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 9.5pt;
}

QPlainTextEdit#SendCommandTextEdit {
    background-color: #1c2229;
    padding: 2px 7px;
}

QPlainTextEdit:focus,
QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QTableWidget:focus {
    background-color: #262d35;
    border-color: #7cd1a8;
}

QComboBox,
QSpinBox {
    min-height: 24px;
    padding: 2px 8px;
}

QComboBox:disabled,
QSpinBox:disabled {
    background-color: #30363d;
    border-color: #444a53;
    color: #858b93;
}

QComboBox::drop-down,
QSpinBox::up-button,
QSpinBox::down-button {
    background-color: #3a4048;
    border-left: 1px solid #555e68;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    width: 22px;
}

QComboBox::down-arrow {
    image: url(":/icons/arrow-down.svg");
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    background-color: #252b32;
    border: 1px solid #555e68;
    color: #f0f4f8;
    selection-background-color: #2e8b57;
    selection-color: #ffffff;
}

QTableWidget QComboBox {
    margin: 2px 3px;
    min-height: 0;
    padding: 0 6px;
}

QTableWidget QComboBox::drop-down {
    width: 20px;
}

QTableWidget QComboBox::down-arrow {
    width: 10px;
    height: 10px;
}

QTabWidget::pane {
    background-color: #303841;
    border: 1px solid #4b5561;
    border-radius: 6px;
    top: 0;
}

QTabBar::tab {
    background-color: #252b32;
    border: 1px solid #4b5561;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    color: #a6accd;
    font-weight: 700;
    min-width: 86px;
    padding: 7px 14px;
}

QTabBar::tab:selected {
    background-color: #303841;
    border-bottom-color: #303841;
    color: #ffffff;
}

QTabBar::tab:hover:!selected {
    background-color: #38414b;
    color: #dce3ea;
}

QTableWidget {
    background-color: #1f2328;
    alternate-background-color: #262c33;
    border: 1px solid #444a53;
    color: #e0e0e0;
    font-size: 9pt;
    gridline-color: #333942;
    selection-background-color: #2e8b57;
    selection-color: #ffffff;
}

QTableWidget::indicator {
    background-color: #444a53;
    border: 1px solid #68727f;
    border-radius: 4px;
    height: 16px;
    width: 16px;
}

QTableWidget::indicator:unchecked {
    image: url(":/icons/x.svg");
}

QTableWidget::indicator:checked {
    background-color: #3cb371;
    border-color: #2e8b57;
    image: url(":/icons/check.svg");
}

QHeaderView::section {
    background-color: #3a3f47;
    border: 1px solid #555e68;
    color: #f0f0f0;
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 10px;
    font-weight: 700;
    padding: 4px;
}

QScrollBar:vertical,
QScrollBar:horizontal {
    background-color: #222831;
    border: none;
    margin: 0;
}

QScrollBar:vertical {
    width: 12px;
}

QScrollBar:horizontal {
    height: 12px;
}

QScrollBar::handle {
    background-color: #555e68;
    border-radius: 6px;
    min-height: 28px;
    min-width: 28px;
}

QScrollBar::handle:hover {
    background-color: #6d7783;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    background-color: transparent;
    border: none;
}

QStatusBar {
    background-color: #20262d;
    border-top: 1px solid #3b444e;
    color: #a6accd;
}

QToolTip {
    background-color: #151a20;
    border: 1px solid #7cd1a8;
    border-radius: 4px;
    color: #f0f4f8;
    font-size: 9pt;
    padding: 6px 8px;
}

QDialog {
    border: 1px solid #444a53;
    border-radius: 8px;
}

QDialog QLabel {
    color: #dce3ea;
}

QDialogButtonBox QPushButton {
    min-width: 78px;
}

QPushButton#green_button {
    background-color: #3cb371;
    border-color: #2e8b57;
    color: #101418;
}

QPushButton#green_button:hover {
    background-color: #5dc88d;
}

QPushButton#green_button:pressed {
    background-color: #31965e;
}

QPushButton#red_button {
    background-color: #5a3038;
    border-color: #8b3a46;
    color: #ffffff;
}

QPushButton#red_button:hover {
    background-color: #7a3d4a;
    border-color: #f7768e;
}

QPushButton#red_button:pressed {
    background-color: #4a252c;
}
