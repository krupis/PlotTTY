/* Charcoal workspace, restrained borders, and visible keyboard focus. */
* { color: #e4e8ed; font-family: "Inter", "Segoe UI", "Arial"; font-size: 10pt;
    selection-background-color: #365c70; selection-color: #ffffff; }
QMainWindow, QDialog, #centralwidget { background: #242a30; }
QLabel { background: transparent; }
QLabel#CaptureTitle { color: #a2adb8; }
QDialog#ConnectionPopover { border: 1px solid #627180; background: #2a323b; }
QLabel#ConnectionHeading { font-weight: 600; font-size: 11pt; }
QToolButton#SettingsSection { border: none; background: transparent; padding: 3px 0; }
QToolButton#SettingsSection:hover { color: #ffffff; }
QLabel#SeriesHeading, QLabel#ExtractionHeading { font-weight: 600; padding: 4px 0 8px; }
QLabel#PortStatusLabel { color: #a2adb8; padding: 0 12px; }
QLabel#PortStatusLabel[connected="true"] { color: #7cd1a8; }
QLabel#ValidationError { color: #ffadb7; }
QPushButton, QToolButton { background: #303941; border: 1px solid #46515b;
    border-radius: 4px; padding: 5px 12px; min-height: 22px; }
QPushButton:hover, QToolButton:hover { background: #3a454f; border-color: #768694; }
QPushButton:pressed, QToolButton:pressed { background: #26313a; }
QPushButton:focus, QToolButton:focus { border-color: #89b4fa; }
QPushButton:disabled, QToolButton:disabled { color: #88929c; background: #272e35; border-color: #39424a; }
QPushButton#PlotModeButton:checked { background: #33594b; border-color: #7cd1a8; }
QToolButton#ConsoleToggle { text-align: left; padding: 5px 16px; }
QToolButton#ConsoleToggle:checked { border-color: #89b4fa; }
QLineEdit, QComboBox, QPlainTextEdit, QTableWidget, QListWidget {
    background: #1f252b; border: 1px solid #414b55; border-radius: 4px; }
QLineEdit, QComboBox { min-height: 24px; padding: 3px 8px; }
QComboBox { padding-right: 26px; combobox-popup: 0; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: top right;
    width: 22px; border: none; background: transparent; }
QComboBox::down-arrow { image: url(:/icons/combo-chevron.svg); width: 12px; height: 8px; }
QComboBox::down-arrow:disabled { image: none; }
QCheckBox:disabled { color: #88929c; }
QLineEdit:disabled, QComboBox:disabled { color: #88929c; background: #272e35; }
QLineEdit:focus, QComboBox:focus, QPlainTextEdit:focus, QTableWidget:focus, QListWidget:focus { border-color: #89b4fa; }
QComboBox QAbstractItemView { background: #242c34; selection-background-color: #365c70; }
QPlainTextEdit { padding: 8px; }
QPlainTextEdit#ConsoleTextEdit { font-family: "Menlo", "Consolas"; background: #1b2026; }
QListWidget { border: none; background: transparent; outline: none; }
QListWidget::item { padding: 8px 4px; border: 1px solid transparent; }
QListWidget::item:selected { background: #32434f; border-radius: 4px; }
QListWidget::item:focus { border-color: #89b4fa; }
QTableWidget { alternate-background-color: #262d35; gridline-color: #39434c; }
QTableWidget QComboBox { margin: 2px; padding: 0 26px 0 6px; min-height: 24px; }
QHeaderView::section { background: #303941; border: none; border-bottom: 1px solid #46515b; padding: 8px; }
QMenuBar, QStatusBar { background: #20262c; }
QMenuBar::item { padding: 6px 12px; }
QMenuBar::item:selected, QMenu::item:selected { background: #365c70; }
QMenu { background: #272f37; border: 1px solid #46515b; padding: 4px; }
QMenu::item { padding: 6px 28px 6px 12px; }
QStatusBar { border-top: 1px solid #39434c; }
QStatusBar QLabel { color: #a2adb8; padding: 4px 8px; }
QStatusBar::item { border: none; }
QSplitter::handle { background: #343d46; }
QScrollArea { border: none; background: #1f2328; }
QScrollBar:vertical { background: #22282e; width: 12px; margin: 0; }
QScrollBar:horizontal { background: #22282e; height: 12px; margin: 0; }
QScrollBar::handle { background: #53606b; border-radius: 5px; min-height: 28px; min-width: 28px; }
QScrollBar::handle:hover { background: #71808d; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QToolTip { background: #303941; border: 1px solid #768694; padding: 6px 8px; }
QDialogButtonBox QPushButton { min-width: 72px; }
